# Template for the CheckTick Kubernetes Secret.
#
# 1. cp k8s/secrets.example.env k8s/secrets.env
# 2. Fill in real values (k8s/secrets.env is git-ignored; NEVER commit it —
#    this repository is public and its docs ship inside the container image).
# 3. kubectl create secret generic checktick-secrets -n checktick \
#      --from-env-file=k8s/secrets.env
#    To update an existing Secret:
#      kubectl create secret generic checktick-secrets -n checktick \
#        --from-env-file=k8s/secrets.env --dry-run=client -o yaml | kubectl apply -f -
#
# SECURITY: PLATFORM_CUSTODIAN_COMPONENT must NEVER be placed here or in any
# environment — settings.py hard-fails if it is set. The custodian component
# stays with the custodians, out-of-band (docs/vault.md, control F6).

# --- REQUIRED ---
# PostgreSQL 17 connection string (new password, never reuse anything that
# transited Northflank). Either the Civo managed DB host, or — if you use
# k8s/postgres-cnpg.yaml — the in-cluster CloudNativePG service:
#   postgresql://checktick:CHANGE_ME@checktick-db-rw:5432/checktick
DATABASE_URL=postgresql://checktick:CHANGE_ME@civo-db-host:5432/checktick
# Generate with: openssl rand -base64 50
SECRET_KEY=CHANGE_ME
# AppRole credentials for the Vault instance this cluster uses
VAULT_ROLE_ID=CHANGE_ME
VAULT_SECRET_ID=CHANGE_ME

# --- OPTIONAL (blank = feature disabled; Django defaults handle absence) ---
# OIDC (rotate client secrets in the Google/Azure consoles first)
OIDC_RP_CLIENT_ID_AZURE=
OIDC_RP_CLIENT_SECRET_AZURE=
OIDC_OP_TENANT_ID_AZURE=
OIDC_RP_CLIENT_ID_GOOGLE=
OIDC_RP_CLIENT_SECRET_GOOGLE=
# LLM / AI survey generator
LLM_API_KEY=
LLM_URL=
LLM_AUTH_TYPE=apim
# RCPCH dataset API
EXTERNAL_DATASET_API_KEY=
# TRUD — only needed by the update-snomed-db CronJob
TRUD_API_KEY=
# Email credentials
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# hCaptcha
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
# OpenObserve log shipping (operational logs are stdout; these enable the
# OpenObserve exporter)
LOGS_BASE_URL=
LOGS_KEY=
LOGS_ORGANISATION=checktick
LOGS_STREAM_NAME=prod_logs
