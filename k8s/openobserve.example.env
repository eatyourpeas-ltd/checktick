# openobserve-auth Secret — source env file.
# Copy to k8s/openobserve.env (git-ignored), fill in, then:
#   kubectl -n checktick create secret generic openobserve-auth \
#     --from-env-file=k8s/openobserve.env --dry-run=client -o yaml | kubectl apply -f -
#
# These credentials are consumed by BOTH openobserve.yaml (root user, only
# effective on an empty data dir) and log-collector.yaml (ingestion Basic
# auth). With the restored NF-era data dir the EXISTING root user governs —
# rotate its password in the OpenObserve UI after first login, and ideally
# create a dedicated ingestion-only user for the collector.
OPENOBSERVE_USER=admin@example.com
OPENOBSERVE_PASSWORD=change-me
