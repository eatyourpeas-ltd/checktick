# Template for the LOCAL CONFIG OVERLAY (checktick-config-local ConfigMap).
#
# 1. cp k8s/config.example.env k8s/config.env
# 2. Fill in your real values, then apply:
#      kubectl create configmap checktick-config-local -n checktick \
#        --from-env-file=k8s/config.env --dry-run=client -o yaml | kubectl apply -f -
#
# RULES
#   - kubectl stores env-file values RAW: never wrap values in quotes
#     (quotes INSIDE a value, e.g. font stacks, are kept literally).
#   - DELETE lines you don't want set. A blank KEY= is NOT neutral: it
#     overrides the settings.py default with an empty string.
#   - This overlay OVERRIDES the committed checktick-config defaults
#     (envFrom order); credentials belong in k8s/secrets.env, not here.
#
# DELIBERATELY ABSENT (never set for the hosted SaaS):
#   SELF_HOSTED=True would disable billing — hosted service never sets it.
#   HOSTING_API_* are not set in production; deploys run via the Deploy (Civo)
#     GitHub workflow.
#   DEBUG / VAT_RATE / BASE_SEAT_PRICE_EX_VAT have correct settings.py
#     defaults and live in the committed ConfigMap or nowhere.

# --- Hosts / TLS: overlay your real domain over the internal defaults ---
ALLOWED_HOSTS=checktick.example,checktick-web,localhost
# Public hostnames APPENDED by settings.py on top of the web Deployment's
# in-cluster ALLOWED_HOSTS (pod IP + service names, set in k8s/web.yaml).
# Set your real domain(s) here — the overlay owns the public hosts:
ALLOWED_HOSTS_EXTRA=checktick.example
CSRF_TRUSTED_ORIGINS=https://checktick.example
SITE_URL=https://checktick.example
CORS_ALLOWED_ORIGINS=https://checktick.example
FORWARDED_ALLOW_IPS=*

# --- Environment ---
ENVIRONMENT=production

# --- Branding ---
BRAND_TITLE=CheckTick
BRAND_NAME=CheckTick
BRAND_THEME=checktick
BRAND_THEME_PRESET_LIGHT=lofi
BRAND_THEME_PRESET_DARK=dim
BRAND_ICON_ALT=CheckTick

# --- Compliance & governance contacts ---
DPO=
DPO_EMAIL=
SIRO=
SIRO_EMAIL=
CALDICOTT=
CALDICOTT_EMAIL=
IG_LEAD=
IG_LEAD_EMAIL=
CTO=
CTO_EMAIL=
CSO=
CSO_EMAIL=
CSO_GMC_NUMBER=
DEFAULT_ORGANISATION=

# --- Company / legal ---
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_VAT_NUMBER=
COMPANY_REGISTRATION_NUMBER=
COMPANY_ODS_CODE=
ICO_NUMBER=
VAT_NUMBER=

# --- Logging (OpenObserve) — LOGS_KEY is a credential: secrets.env ---
LOGS_BASE_URL=
LOGS_ORGANISATION=checktick
LOGS_STREAM_NAME=prod
DEFAULT_STREAM_NAME=prod

# --- Email (host/port here; EMAIL_HOST_USER/PASSWORD in secrets.env) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@checktick.example
SERVER_EMAIL=server@checktick.example

# --- External dataset sources (URLs/IDs here; API keys in secrets.env) ---
OSDATAHUB_PROJECT_ID=
OSDATAHUB_API_URL=
POSTCODES_API_URL=
IMD_API_URL=

# --- OIDC (client IDs here; client secrets in secrets.env) ---
OIDC_RP_CLIENT_ID_AZURE=
OIDC_OP_TENANT_ID_AZURE=
OIDC_RP_CLIENT_ID_GOOGLE=
OIDC_RP_SIGN_ALGO=RS256
OIDC_OP_JWKS_ENDPOINT_GOOGLE=https://www.googleapis.com/oauth2/v3/certs
OIDC_OP_JWKS_ENDPOINT_AZURE=https://login.microsoftonline.com/common/discovery/v2.0/keys

# --- Microsoft Graph / NHSmail (client secret in secrets.env) ---
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=

# --- hCaptcha (sitekey is public; HCAPTCHA_SECRET in secrets.env) ---
HCAPTCHA_SITEKEY=

# --- LLM (LLM_API_KEY in secrets.env) ---
LLM_ENABLED=False
LLM_URL=
LLM_AUTH_TYPE=apim
LLM_MODEL=
LLM_TIMEOUT=
LLM_MAX_RETRIES=
LLM_TEMPERATURE=

# --- Payments (base URLs here; keys and webhook secrets in secrets.env) ---
PAYMENT_PROCESSING_SANDBOX_BASE_URL=
PAYMENT_PROCESSING_PRODUCTION_BASE_URL=
